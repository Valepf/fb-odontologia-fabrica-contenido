# Copiá este archivo como .env.local. No se sube a Git.

# ── Chrome / Edge (opcional) ───────────────────────────────────────────
# En Windows el sistema busca Chrome y Edge automáticamente.
# Sólo completá CHROME_PATH si no los encuentra. Ejemplo:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=

# ── Vercel Blob ────────────────────────────────────────────────────────
# Se configura recién cuando pasemos de render local a publicación.
BLOB_READ_WRITE_TOKEN=

# ── Instagram / Meta ───────────────────────────────────────────────────
# Se configura más adelante. El sistema puede renderizar sin estas claves.
IG_GRAPH_BASE=
IG_USER_ID=
IG_ACCESS_TOKEN=
