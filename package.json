{
  "name": "fabrica-contenido-fb-odontologia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fábrica de carruseles de Instagram para Fabián Beltrán Odontología.",
  "scripts": {
    "fuentes": "node scripts/bajar-fuentes.mjs",
    "tipografias": "node --env-file-if-exists=.env.local scripts/probar-tipografias.mjs",
    "render": "node --env-file-if-exists=.env.local content-studio/render.mjs",
    "grilla": "node --env-file-if-exists=.env.local scripts/grilla.mjs",
    "doctor": "node --env-file-if-exists=.env.local scripts/doctor.mjs",
    "verificar": "node scripts/verificar.mjs",
    "stage": "node --env-file-if-exists=.env.local scripts/stage.mjs",
    "publicar": "node --env-file-if-exists=.env.local scripts/publicar.mjs",
    "publicar:simulacro": "node --env-file-if-exists=.env.local scripts/publicar.mjs --simulacro",
    "ig:setup": "node --env-file-if-exists=.env.local scripts/setup-instagram.mjs",
    "ig:check": "node --env-file-if-exists=.env.local scripts/check-instagram.mjs",
    "cloudinary:check": "node --env-file-if-exists=.env.local scripts/check-cloudinary.mjs"
  },
  "dependencies": {
    "cloudinary": "^2.10.1",
    "puppeteer-core": "^24.9.0"
  }
}
